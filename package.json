		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./build/packaged.ts",
		"debug": "ts-node ./build/dev.ts",
		"dryrun": "ts-node ./build/dryrun.ts",
		"logo": "node ./build/logo.mjs",
		"verify": "node ./build/verify-package.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.4.8",
		"@types/fs-extra": "^11.0.4",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3",
		"ws": "^8.18.0"
	}
