		"type": "git",
		"url": "git+https://github.com/Oriuguisu/lceda-thieving-copper.git"
	},
	"bugs": {
		"url": "https://github.com/Oriuguisu/lceda-thieving-copper/issues"
	},
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ ./iframe/ && ts-node ./config/esbuild.prod.ts",
